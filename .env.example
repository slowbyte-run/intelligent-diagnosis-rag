# 复制为 .env 并填写。.env 已 gitignore，不要把真实口令提交进仓库。
#
# 本地服务用：docker compose 会读取同目录的 .env 做变量替换。
#   1. cp .env.example .env
#   2. 填写 NEO4J_PASSWORD 与 POSTGRES_PASSWORD（任意强口令）
#   3. docker compose up -d
#
# 两条 API key 只需占位值即可跑 `idr doctor`（它只检查配置是否存在与两个数据库能否连通）；
# 真正入库抽取时才需要有效值。
#
# 运行集成测试前需要把 .env 导入当前 shell：
#   set -a; source .env; set +a

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# 有些 OpenAI 兼容网关要求额外的请求头，以 JSON 对象提供；留空表示不加。
# 例：LLM_EXTRA_HEADERS='{"x-opencode-session": "idr"}'
LLM_EXTRA_HEADERS=

SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_DIM=1024
RERANK_MODEL=Qwen/Qwen3-Reranker-8B

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

POSTGRES_USER=idr
POSTGRES_PASSWORD=
POSTGRES_DB=idr
DATABASE_URL=
